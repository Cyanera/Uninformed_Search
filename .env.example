# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Safe to expose to the browser: every table is
# protected by row level security (see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / secret key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used by the student API routes so that students can join and submit without
# holding a Supabase account of their own.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Optional - only used by `npm run setup` and `npm run demo`, never at runtime
# ---------------------------------------------------------------------------

# Supabase > Project Settings > Database > Connection string > URI.
# Set this and `npm run setup` applies the schema and seed for you, instead of
# asking you to paste SQL into the dashboard.
SUPABASE_DB_URL=

# `npm run setup` creates this instructor account, already confirmed, so you do
# not have to wait for a confirmation email before your first lecture.
INSTRUCTOR_EMAIL=
INSTRUCTOR_PASSWORD=
