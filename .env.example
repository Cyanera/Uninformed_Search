# ===========================================================================
# Copy this file to .env.local and fill it in. Every value comes from your
# Supabase project dashboard.
# ===========================================================================


# ---------------------------------------------------------------------------
# Project Settings  >  API          (the gear icon, bottom left)
# ---------------------------------------------------------------------------

# "Project URL". Looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLIC key. Newer projects call it "Publishable key" (sb_publishable_...);
# older ones call it "anon public" under Project API keys. Either works.
# Safe in the browser: every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The SECRET key. Newer projects call it "Secret key" (sb_secret_...); older
# ones call it "service_role secret" and hide it behind a Reveal button.
# SERVER ONLY - never prefix this one with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Optional - used only by `npm run setup` and `npm run demo`, never at runtime
# ---------------------------------------------------------------------------

# Project Settings > Database > Connection string > URI.
#
# Set this and `npm run setup` creates the tables and seeds the problem for
# you. Leave it empty and the script tells you which two SQL files to paste
# into the SQL Editor instead.
#
# Two things to watch:
#   * Replace [YOUR-PASSWORD] with the database password you chose when you
#     created the project. It is not any of the API keys above.
#   * Use port 5432 ("Direct connection", or "Session pooler" if your network
#     has no IPv6). Port 6543 is the transaction pooler and cannot run
#     migrations.
#
# SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.abcdefghijklm.supabase.co:5432/postgres
SUPABASE_DB_URL=

# `npm run setup` creates this instructor account, already confirmed, so no
# confirmation email stands between you and your first lecture.
# The password must be at least 6 characters.
INSTRUCTOR_EMAIL=
INSTRUCTOR_PASSWORD=
